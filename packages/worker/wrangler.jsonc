{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "badyum",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // nodejs_compat не нужен: ядро специально написано на Web Crypto. Если где-то
  // всплывёт node:*, это должно упасть, а не тихо заработать на полифилле.
  "observability": { "enabled": true },

  "durable_objects": {
    "bindings": [
      // Каталог каналов и инвайтов. Экземпляр один на весь сервис: коды
      // инвайтов и кодовые слова обязаны быть уникальными глобально.
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Registry"] }
  ]
}

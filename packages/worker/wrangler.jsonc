{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "badyum",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // nodejs_compat не нужен: ядро написано на Web Crypto. Если где-то всплывёт
  // node:*, это должно упасть, а не тихо заработать на полифилле.
  "observability": { "enabled": true },

  // Порт задан явно. По умолчанию wrangler занимает 8787 — тот же, на котором
  // слушает сигналинг-сервер, и при одновременном запуске побеждал бы тот, кто
  // успел первым. Проигравший падал молча, а приложение оставалось без /ws.
  "dev": { "port": 8788 },

  /**
   * Статика клиента отдаётся тем же Worker'ом, а не отдельным проектом Pages:
   * один домен на страницу, API и WebSocket — значит нет CORS и нет второго
   * адреса, который надо где-то прописывать.
   *
   * single-page-application возвращает index.html на неизвестный путь. Без
   * этого человек по ссылке-приглашению получал бы 404.
   */
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Запросы к /api и /ws обязаны дойти до кода, а не быть перехвачены
    // статикой раньше него.
    "run_worker_first": ["/api/*", "/ws"]
  },

  /**
   * База пользователей.
   *
   * database_id — не секрет: без доступа к аккаунту он бесполезен, и сам
   * Cloudflare держит его в этом файле.
   */
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "badyuma",
      "database_id": "1aa7dfb4-2939-4406-81bf-c4af41b412d5",
      "migrations_dir": "migrations"
    }
  ],

  "durable_objects": {
    "bindings": [
      // Каталог каналов и инвайтов: коды и кодовые слова уникальны глобально.
      { "name": "REGISTRY", "class_name": "Registry" },
      // Комнаты: по объекту на канал, он же держит сокеты участников.
      { "name": "ROOMS", "class_name": "ChannelRoom" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Registry"] },
    { "tag": "v2", "new_sqlite_classes": ["ChannelRoom"] }
  ],

  "vars": {
    "BADYUM_MAX_PARTICIPANTS": "8"
  }
}

{
  "name": "badyum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "//": "Версия pnpm закреплена: без неё corepack в образах и CI тянет свежую, и сборка перестаёт быть воспроизводимой.",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./packages/*\" dev",
    "build": "pnpm --filter \"./packages/*\" build",
    "typecheck": "pnpm --filter \"./packages/*\" typecheck",
    "test": "pnpm --filter \"./packages/*\" test",
    "//release": "Выкладка в прод из корня. Сам скрипт живёт в пакете worker, но искать его там надо знать: из корня «pnpm release» просто не находило команду.",
    "release": "pnpm --filter @badyum/worker release",
    "turn": "docker compose -f infra/docker-compose.yml up -d",
    "demo": "pnpm --filter @badyum/client build && pnpm --parallel --filter @badyum/server --filter @badyum/client serve"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}

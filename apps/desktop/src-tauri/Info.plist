<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Без этого ключа macOS не показывает запрос разрешения, а СНИМАЕТ приложение
    в тот момент, когда оно просит микрофон. То есть установщик ставится,
    приложение открывается, а при входе в канал просто исчезает — и понять по
    этому, что случилось, нельзя.

    Текст показывается человеку в системном окне, поэтому он объясняет причину,
    а не повторяет название приложения.
  -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Микрофон нужен, чтобы вас слышали в голосовом канале.</string>
</dict>
</plist>

{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Badyum",
  "version": "0.1.0",
  "identifier": "app.badyum.desktop",
  "build": {
    "frontendDist": "../../../packages/client/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @badyum/server --filter @badyum/client --parallel dev",
    "beforeBuildCommand": "pnpm --filter @badyum/client build:desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Badyum",
        "width": 1100,
        "height": 740,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#0b0c11"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}

# Скопируй в infra/.env и заполни.
#
#   cp infra/.env.example infra/.env

# Домен, направленный A-записью на этот сервер. Caddy получит по нему
# сертификат сам — отдельно ничего настраивать не нужно.
BADYUM_DOMAIN=badyum.example.com

# Подпись токенов входа. Любая длинная случайная строка:
#   openssl rand -hex 32
BADYUM_TOKEN_SECRET=

# Общий секрет с coturn: по нему сервер выдаёт короткоживущие TURN-креды.
# Статический логин с паролем светился бы в DevTools у каждого пользователя.
#   openssl rand -hex 32
BADYUM_TURN_SECRET=

# Белый IP этой машины. За NAT coturn без него раздаёт неверные кандидаты,
# и relay молча не работает.
BADYUM_TURN_EXTERNAL_IP=

# Адрес relay для клиентов. Список, а не один хост: «вне геолокации» на
# практике означает TURN в нескольких регионах.
BADYUM_TURN_HOSTS=turn:badyum.example.com:3478?transport=udp

# Потолок mesh-топологии. Выше — нужен SFU, а не N² соединений.
BADYUM_MAX_PARTICIPANTS=8

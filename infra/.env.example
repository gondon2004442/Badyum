# Скопируй в infra/.env и заполни.
#
#   cp infra/.env.example infra/.env

# Домены, направленные A-записью на этот сервер. Можно несколько через запятую —
# Caddy получит сертификат на каждый. Второй домен полезен как запасной вход:
# если один окажется недоступен, ссылки на другом продолжат работать.
BADYUM_DOMAIN=badyum.ru, badyum.online

# Откуда браузеру разрешено обращаться к серверу. Перечисли все домены со
# схемой, плюс источники десктопного приложения — без них оно не подключится.
BADYUM_ORIGINS=https://badyum.ru,https://badyum.online,tauri://localhost,http://tauri.localhost

# Подпись токенов входа. Любая длинная случайная строка:
#   openssl rand -hex 32
BADYUM_TOKEN_SECRET=

# Общий секрет с coturn: по нему сервер выдаёт короткоживущие TURN-креды.
# Статический логин с паролем светился бы в DevTools у каждого пользователя.
#   openssl rand -hex 32
BADYUM_TURN_SECRET=

# Realm для relay — ровно один домен, без запятых.
BADYUM_TURN_REALM=badyum.ru

# Белый IP этой машины. За NAT coturn без него раздаёт неверные кандидаты,
# и relay молча не работает.
BADYUM_TURN_EXTERNAL_IP=

# Адрес relay для клиентов. Список, а не один хост: «вне геолокации» на
# практике означает TURN в нескольких регионах.
BADYUM_TURN_HOSTS=turn:badyum.ru:3478?transport=udp

# Потолок mesh-топологии. Выше — нужен SFU, а не N² соединений.
BADYUM_MAX_PARTICIPANTS=8
